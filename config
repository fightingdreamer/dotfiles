command = /usr/bin/fish --login --command zellij
# command = $HOME/.nix-profile/bin/fish --login --command fish

# Linux
freetype-load-flags = no-hinting,no-force-autohint,no-autohint,no-light
mouse-scroll-multiplier = precision:1,discrete:1
window-decoration = server


cursor-style-blink = false

# Iosevka
# Curly
# SS01 + Andale Mono Style
# SS02 - Anonymous Pro Style
# SS03 - Consolas Style
# SS04 - Menlo Style
# SS05 - Fira Mono Style
# SS06 - Liberation Mono Style
# SS07 - Monaco Style
# SS08 + Pragmata Pro Style
# SS09 + Source Code Pro Style
# SS10 + Envy Code R Style
# SS11 + X Windows Fixed Style
# SS12 + Ubuntu Mono Style
# SS13 - Lucida Style
# SS14 + JetBrains Mono Style
# SS15 - IBM Plex Mono Style
# SS16 - PT Mono Style
# SS17 - Recursive Mono Style
# SS18 - Input Mono Style

font-family = Iosevka Term
font-size = 12

# font-family = JetBrains Mono
# font-size = 11

font-style = Regular
font-style-bold = Bold
font-style-italic = Regular Italic
font-style-bold-italic = Bold Italic

font-thicken = false
font-thicken-strength = 0

font-feature = -calt,-liga,-dlig

adjust-cell-width = 0
adjust-cell-height = 2

adjust-cursor-height = 2
adjust-cursor-thickness = 2

window-inherit-font-size = false

window-padding-x = 4
window-padding-y = 4

# macos-option-as-alt = left

# theme = dayfox
theme = duskfox

