# https://github.com/anthropics/claude-code/issues/1282#issuecomment-3185584410
keybind = shift+enter=text:\x1b\r

# Super+C as copy
keybind = super+c=copy_to_clipboard:mixed

# Super+V as paste
keybind = super+v=paste_from_clipboard
